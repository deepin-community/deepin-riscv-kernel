CC_ARCH=aarch64
KERNEL_GIT=https://github.com/radxa-pkg/linux-a733.git
KERNEL_BRANCH=main
KERNEL_DEFCONFIG="defconfig radxa.config radxa_custom.config bsp.config"
PKG_DEPS=(quilt)

function override_clone() {
	export GIT_CLONE_PROTECTION_ACTIVE=false
	mkdir -p work
	git clone --recurse-submodules --depth=1 -b "$KERNEL_BRANCH" "$KERNEL_GIT" work/kernel
}

function override_patch() {
    # link bsp
	ln -srf bsp src/bsp
	
	# add extra config
	ln -srf device-a733/configs/default/linux-5.15/bsp_defconfig src/arch/arm64/configs/bsp.config
	
	# copy dts
	for _board in a7a a7s a7z; do
        ln -srf device-a733/configs/cubie_${_board}/linux-5.15/board.dts src/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-${_board}.dts
    done
    cp -aR bsp/configs/linux-5.15/*.dtsi src/arch/arm64/boot/dts/allwinner
    cp -aR bsp/include/dt-bindings/. src/include/dt-bindings
    
    # add version info
    echo "#define AW_BSP_VERSION \"$(git log -n 1 --abbrev=10 --pretty=format:"%h"), $(date "+%Y-%m-%d %H:%M:%S"), RadxaOS SDK\"" > bsp/include/sunxi-autogen.h

    # add radxa patch
	dh_quilt_patch

	pushd src
		ln -s bsp/modules modules
		ln -s bsp/platform platform
		. $1
	popd
}

function override_compile_env() {
    . $1
    MAKE_EXEC="$MAKE_EXEC KBUILD_DEFCONFIG=bsp.config BSP_TOP=bsp/ LICHEE_KERN_DIR=./ KERNEL_SRC_DIR=$(pwd)/src"
}

function override_config() {
	pushd src
		. $1
		# multiple definition of `sunxi_jack_adv'
		sed -i 's/CONFIG_SND_SOC_AC101=y/CONFIG_SND_SOC_AC101=m/' .config
		sed -i 's/CONFIG_SND_SOC_AC101B=y/CONFIG_SND_SOC_AC101B=m/' .config
	popd
}

function override_compile() {
	pushd src
		. $1
	popd
}

function override_cleanup() {
	mkdir -p $OUTPUT_DIR/deb $OUTPUT_DIR/deb-dbg
	cp work/kernel/*.deb $OUTPUT_DIR/deb
	find $OUTPUT_DIR/deb/ -type f -name "*.deb" | grep '\-dbg_' | xargs -I @ mv @ $OUTPUT_DIR/deb-dbg/
}
