+++ b/arch/arm64/boot/dts/qcom/sm8150.dtsi
@@ -2087,6 +2087,8 @@ ufs_mem_hc: ufshc@1d84000 {
 			resets = <&gcc GCC_UFS_PHY_BCR>;
 			reset-names = "rst";
 
+			power-domains = <&gcc UFS_PHY_GDSC>;
+
 			iommus = <&apps_smmu 0x300 0>;
 
 			clock-names =
