+	if ((count + 1) / 3 > GESTURE_MASK_SIZE + 1) {
+		pr_err("%s: Number of bytes of parameter wrong! %zu > (enable/disable + %d )\n",
+			__func__, (count + 1) / 3, GESTURE_MASK_SIZE);
+		mask[0] = 0;
+	} else {
+		mask[0] = ((count + 1) / 3) - 1;
+		for (n = 1; n <= (count + 1) / 3; n++) {
+			if (sscanf(p, "%02X ", &temp) == 1) {
+				p += 3;
+				mask[n] = (u8)temp;
