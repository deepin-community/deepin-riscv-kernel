UBOOT_GIT=https://github.com/radxa-pkg/u-boot-aw2501.git
UBOOT_BRANCH=main
UBOOT_DEFCONFIGS=(radxa-cubie-a7z_defconfig radxa-cubie-a7a_defconfig radxa-cubie-a7e_defconfig)
UBOOT_PATCHES=(allwinner/bootm-size.patch)
PKG_DEPS=(
  devscripts quilt
  crossbuild-essential-armel
  dh-exec python3-setuptools python3-dev libgnutls28-dev python3-pyelftools xxd lib32stdc++6 lib32z1 dos2unix
)
GCC_ARCH=aarch64

function override_clone() {
	export GIT_CLONE_PROTECTION_ACTIVE=false
	mkdir -p work
	git clone --recurse-submodules -b "$UBOOT_BRANCH" "$UBOOT_GIT" work/uboot
}

function override_patch() {
    pushd src
        . $1
    popd
}

function override_config() {
    for _defconfig in ${UBOOT_DEFCONFIGS[@]}; do
    cat <<EOF | tee -a src/configs/${_defconfig}
CONFIG_SUNXI_COMP_DETECT=y
CONFIG_LZ4=y
CONFIG_LZMA=y
CONFIG_LZO=y
CONFIG_SPL_LZO=y
CONFIG_SPL_GZIP=y   
EOF
    done
}

function override_compile() {
	make install_toolchain
	mkdir -p arisc/ar100s/tools/riscv64-elf-x86_64-20201104
	tar xf arisc/ar100s/tools/riscv64-elf-x86_64-20201104.tar.gz -C arisc/ar100s/tools/riscv64-elf-x86_64-20201104
	
    make deb
    
    cp -avr debian/u-boot-aw2501/usr/lib/u-boot/* $OUTPUT_DIR/
}
