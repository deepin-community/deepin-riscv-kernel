UBOOT_GIT=https://gitlab.collabora.com/hardware-enablement/rockchip-3588/u-boot.git
UBOOT_BRANCH=rockchip
UBOOT_DEFCONFIGS=(
    evb-rk3576_defconfig
    generic-rk3576_defconfig
    rock4d-rk3576_defconfig
    roc-pc-rk3576_defconfig
    sige5-rk3576_defconfig
    dshanpi-a1-rk3576_defconfig
)
UBOOT_RESULT_FILENAMES=(
	idbloader.img
	u-boot.itb
	u-boot-rockchip.bin
	u-boot-rockchip-spi.bin
)
UBOOT_PATCHES=(
  rockchip/dshanpi-dts.patch
  rockchip/dshanpi-config.patch
)
GCC_ARCH=aarch64
PKG_DEPS=(python3-pyelftools)
NOCCACHE=1

function override_clone() {
	. $1
	git clone --depth 1 https://gitlab.collabora.com/hardware-enablement/rockchip-3588/rkbin.git work/rkbin
	export ROCKCHIP_TPL=$(find $(pwd)/work/rkbin/bin/rk35/ -name "rk3576_ddr_*" | grep -v -e ultra -e eyescan | sort -r | head -n 1)
	export BL31=$(find $(pwd)/work/rkbin/bin/rk35/ -name "rk3576_bl31_*" | sort -r | head -n 1)
}

function override_compile() {
	pushd ../rkbin
		./tools/boot_merger RKBOOT/RK3576MINIALL.ini
		find . -name "rk3576_spl_loader_*" | xargs -I @ cp -av @ $OUTPUT_DIR/
	popd
	
    . $1
}
