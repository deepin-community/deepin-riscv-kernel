GCC_ARCH=aarch64
PKG_DEPS=(python3-pyelftools)
NOCCACHE=1

function override_clone() {
	. $1
	git clone --depth 1 https://gitlab.collabora.com/hardware-enablement/rockchip-3588/rkbin.git work/rkbin
	git clone --depth 1 https://gitlab.collabora.com/hardware-enablement/rockchip-3588/trusted-firmware-a.git work/tfa
	export ROCKCHIP_TPL=$(find $(pwd)/work/rkbin/bin/rk35/ -name "rk3588_ddr_*" | sort -r | head -n 1)
}

function override_compile() {
	pushd ../tfa
		make realclean
		make PLAT=rk3588 bl31
		export BL31=$(pwd)/build/rk3588/release/bl31/bl31.elf
	popd

	pushd ../rkbin
		./tools/boot_merger RKBOOT/RK3588MINIALL.ini
		find . -name "rk3588_spl_loader_*" | xargs -I @ cp -av @ $OUTPUT_DIR/
	popd

    . $1
}
