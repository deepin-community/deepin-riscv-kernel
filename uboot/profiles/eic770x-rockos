UBOOT_BRANCH=rockos-v2024.01
UBOOT_SBI_BRANCH=rockos-dev
UBOOT_GIT=https://github.com/rockos-riscv/rockos-u-boot.git
UBOOT_SBI=1
UBOOT_SBI_GIT=https://github.com/rockos-riscv/rockos-opensbi.git
UBOOT_SBI_PLATFORM=generic
UBOOT_SBI_MAKE_ARGS="FW_PAYLOAD=y"
DEFCONFIG_LISTS=(
  eic7700-evb:eic7700-evb:eic7700_evb_defconfig:ddr_fw
  eic7700-evb-a2:eic7700-evb-a2:eic7700_evb_a2_defconfig:ddr_fw
  eic7700-evb-a3:eic7700-evb-a3:eic7700_evb_a3_defconfig:ddr_fw
  hifive-p550:eic7700-hifive-premier-p550:hifive_premier_p550_defconfig:ddr_fw
  milkv-megrez:eic7700-milkv-megrez:eic7700_milkv_megrez_defconfig:ddr_fw
  milkv-megrez-nx:eic7700-milkv-megrez-nx:eic7700_milkv_megrez_nx_defconfig:ddr_fw_nx
  pine64-starpro64:eic7700-pine64-starpro64:eic7700_starpro64_defconfig:ddr_fw
  eic7700-sbc:eic7700-sbc:eic7700_sbc_defconfig:ddr_fw
)
UBOOT_RESULT_FILENAMES=(u-boot.bin u-boot.dtb)
UBOOT_SBI_RESULT_FILENAMES=(fw_payload.bin)
UBOOT_PATCHES=(ufetch-2024.patch)

function override_compile() {

for DEFCONFIG_LIST in "${DEFCONFIG_LISTS[@]}"; do

UBOOT_OUTPUT_DIR=$(echo $DEFCONFIG_LIST | cut -f1 -d ':')
UBOOT_DTFILE=$(echo $DEFCONFIG_LIST | cut -f2 -d ':')
UBOOT_DEFCONFIG=$(echo $DEFCONFIG_LIST | cut -f3 -d ':')
UBOOT_SBI_FW=$(echo $DEFCONFIG_LIST | cut -f4 -d ':')

echo "compile for $UBOOT_OUTPUT_DIR"

$MAKE_EXEC $UBOOT_DEFCONFIG
sed -i "s#eswin/eic7700-evb-a2.dtb#eswin/$UBOOT_DTFILE.dtb#" .config
echo 'CONFIG_CMD_UFETCH=y' >> .config
$MAKE_EXEC -j$(nproc)

mkdir -p $OUTPUT_DIR/${UBOOT_OUTPUT_DIR}

for UBOOT_RESULT_FILENAME in "${UBOOT_RESULT_FILENAMES[@]}"; do
        find . -name "$UBOOT_RESULT_FILENAME" | xargs -I @ cp -av @ $OUTPUT_DIR/${UBOOT_OUTPUT_DIR}/
done

pushd ../sbi
	$MAKE_EXEC PLATFORM=$UBOOT_SBI_PLATFORM $UBOOT_SBI_MAKE_ARGS FW_FDT_PATH=$OUTPUT_DIR/${UBOOT_OUTPUT_DIR}/u-boot.dtb FW_PAYLOAD_PATH=$OUTPUT_DIR/${UBOOT_OUTPUT_DIR}/u-boot.bin -j$(nproc)
	for UBOOT_SBI_RESULT_FILENAME in "${UBOOT_SBI_RESULT_FILENAMES[@]}"; do
		find . -name "$UBOOT_SBI_RESULT_FILENAME" | xargs -I @ cp -av @ $OUTPUT_DIR/${UBOOT_OUTPUT_DIR}/
	done

	cp -v $OUTPUT_DIR/${UBOOT_OUTPUT_DIR}/fw_payload.bin sign/preload/
	pushd sign/preload
		BOOTCHAIN_CFG=bootchain-${U_BOOT_OUTPUT_DIR}.cfg
		cp bootchain.cfg $BOOTCHAIN_CFG
		sed -i "s#HOLDER#$(pwd)#g" $BOOTCHAIN_CFG
		sed -i "s#ddr_fw#${UBOOT_SBI_FW}#g" $BOOTCHAIN_CFG
		../nsign $BOOTCHAIN_CFG
		cp -v bootloader_secboot_ddr5.bin $OUTPUT_DIR/${UBOOT_OUTPUT_DIR}/
	popd
popd

$MAKE_EXEC clean
	
done

}
