UBOOT_GIT=https://github.com/u-boot/u-boot.git
UBOOT_DEFCONFIGS=(evb-rk3588_defconfig)
UBOOT_RESULT_FILENAMES=(
	idbloader.img
	rk3588_spl_loader_*.bin
	u-boot-rockchip.bin
	u-boot-rockchip-spi.bin
	u-boot.itb
)
GCC_ARCH=aarch64
PKG_DEPS=(python3-pyelftools)

function override_clone() {
	. $1
	git clone --depth 1 https://github.com/rockchip-linux/rkbin work/rkbin
	export ROCKCHIP_TPL=$(find $(pwd)/work/rkbin/bin/rk35/ -name "rk3588_ddr_*" | sort -r | head -n 1)
	export BL31=$(find $(pwd)/work/rkbin/bin/rk35/ -name "rk3588_bl31_*" | sort -r | head -n 1)
}


