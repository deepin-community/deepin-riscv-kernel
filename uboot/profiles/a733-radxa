UBOOT_GIT=https://github.com/radxa-pkg/u-boot-aw2501.git
UBOOT_BRANCH=main
PKG_DEPS=(
  devscripts quilt
  gcc-arm-linux-gnueabi crossbuild-essential-armel
  dh-exec python3-setuptools python3-dev libgnutls28-dev python3-pyelftools xxd lib32stdc++6 lib32z1 dos2unix
)
CC_ARCH=aarch64

_MAKE_PROFILES=(radxa-cubie-a7a radxa-cubie-a7a-ac101 radxa-cubie-a7z)

function override_clone() {
	export GIT_CLONE_PROTECTION_ACTIVE=false
	mkdir -p work
	git clone --recurse-submodules --depth=1 -b "$UBOOT_BRANCH" "$UBOOT_GIT" work/uboot
}

function override_patch() {
    dh_quilt_patch
    
    pushd src
        UBOOT_PATCHES=(
          allwinner/bootm-size.patch
          allwinner/compression-1.patch
          allwinner/compression-2.patch
          allwinner/compression-3.patch
          allwinner/compression-4.patch
          allwinner/compression-env.patch
          allwinner/optional-fit.patch
          allwinner/uchar.patch
          ufetch-2018.patch
        )
        . $1

        cp ./configs/radxa-cubie-a7a_defconfig ./configs/radxa-cubie-a7a-ac101_defconfig
        sed -i 's/sun60i-a733-cubie-a7a/sun60i-a733-cubie-a7a-ac101/' ./configs/radxa-cubie-a7a-ac101_defconfig
    popd
    
    UBOOT_PATCHES=(allwinner/radxa-use-system-arm-toolchain.patch)
    . $1
}

function override_config() {
    for _make_profile in ${_MAKE_PROFILES[@]}; do
    cat <<EOF | tee -a src/configs/${_make_profile}_defconfig
CONFIG_SUNXI_COMP_DETECT=y
CONFIG_LZ4=y
CONFIG_LZMA=y
CONFIG_LZO=y
CONFIG_SPL_LZO=y
CONFIG_SPL_GZIP=y
CONFIG_CMD_UFETCH=y
EOF
    done
}

function override_compile() {
    # arisc toolchain
    mkdir -p arisc/ar100s/tools/riscv64-elf-x86_64-20201104
    curl -s -L "https://github.com/radxa/allwinner-toolchain/releases/download/aiot-linux-v1.4.6/riscv64-elf-x86_64-20201104.tar.gz" | tar xzf - -C arisc/ar100s/tools/riscv64-elf-x86_64-20201104
    touch arisc/ar100s/tools/.toolchain.flag

    # partition placeholder
    truncate -s 16M /tmp/gpt.img
    sgdisk -o -n 1:-128K:0 -c 1:env /tmp/gpt.img
    dd conv=notrunc,fsync if=/tmp/gpt.img of=src/sys_partition_nor.bin bs=512 count=34

    for _MAKE_PROFILE in ${_MAKE_PROFILES[@]}; do
        if [ "${_MAKE_PROFILE}" == "radxa-cubie-a7a" ]; then
            sed -i 's/sun60i-a733-cubie-a7a-ac101.dtb/sun60i-a733-cubie-a7a.dtb/' ./src/board/sunxi/cubie_board.c
        fi
        if [ "${_MAKE_PROFILE}" == "radxa-cubie-a7a-ac101" ]; then
            sed -i 's/sun60i-a733-cubie-a7a.dtb/sun60i-a733-cubie-a7a-ac101.dtb/' ./src/board/sunxi/cubie_board.c
        fi

        # make output dir
        mkdir -p out/${_MAKE_PROFILE}
    
        # build and pack u-boot
        make ${_MAKE_PROFILE}_pack
        cp src/boot_package-${_MAKE_PROFILE}.fex out/${_MAKE_PROFILE}/boot_package.fex
        
        # BOOT0
        make out/${_MAKE_PROFILE}/boot0_sdcard.bin
        make out/${_MAKE_PROFILE}/boot0_spinor.bin
        make out/${_MAKE_PROFILE}/boot0_ufs.bin
        
        # copy scripts
        cp setup/u-boot_setup-allwinner-a733.sh out/${_MAKE_PROFILE}/setup.sh
        
        # cp placeholder sys_partition_nor.bin
        cp src/sys_partition_nor.bin out/${_MAKE_PROFILE}/
    done

    # collect results
    cp -avr out/* $OUTPUT_DIR/
}
