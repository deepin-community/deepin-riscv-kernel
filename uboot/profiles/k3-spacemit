GCC_VER=13
UBOOT_BRANCH=k3-br-v1.0.y
UBOOT_SBI_BRANCH=k3-br-v1.0.y
UBOOT_GIT=https://gitee.com/spacemit-buildroot/uboot-2022.10.git
UBOOT_SBI_GIT=https://gitee.com/spacemit-buildroot/opensbi.git
UBOOT_SBI_PLATFORM_DEFCONFIG=k3_defconfig
UBOOT_DEFCONFIGS=(k3_defconfig)
UBOOT_SBI=1
UBOOT_RESULT_FILENAMES=(
  FSBL.bin
  u-boot-env-default.bin
  u-boot.itb
  bootinfo_spinand.bin
  bootinfo_spinor.bin
  bootinfo_block.bin
  bianbu.bmp
)
UBOOT_SBI_RESULT_FILENAMES=(
  fw_dynamic.itb
  fw_dynamic.bin
  fw_payload.bin
  fw_jump.bin
)
PKG_DEPS=(u-boot-tools)
UBOOT_PATCHES=(ufetch-2022-k3.patch)

function override_config() {
        . $1

	echo CONFIG_CMD_UFETCH=y >> configs/k3_defconfig
	# for extra ufetch size
	echo CONFIG_SPL_SIZE_LIMIT=0x73F00 >> configs/k3_defconfig
}

function override_patch() {
	. $1

	pushd ../sbi
	patch -p1 < $BASEDIR/uboot/patches/opensbi-k3-csr.patch
	popd
}
